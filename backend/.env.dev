# InsightMind AI — committed DEV-ONLY backend config.
#
# Used by docker-compose.dev.yml to run the whole stack with ZERO external
# accounts: a local throwaway Postgres, local Redis, and mock auth
# (BACKEND_DEV_MODE=true with SUPABASE_JWT_SECRET blank -> every request is the
# dev user 00000000-0000-0000-0000-000000000000).
#
# DO NOT use these values for anything real. The encryption key below is a
# throwaway; regenerate it (and use real Supabase creds in backend/.env) for
# any non-local deployment.

APP_ENV=development
BACKEND_DEV_MODE=true

# Throwaway Fernet key — dev only.
ENCRYPTION_KEY=wyqOf7bL7yAKlVrCh5dgvM9cuu8FQ87_OrfWhc_LLk0=

# Local Postgres from docker-compose.dev.yml (service name "db").
APP_DATABASE_URL=postgresql+psycopg2://insightmind:insightmind@db:5432/insightmind
DATABASE_URL=postgresql://insightmind:insightmind@db:5432/insightmind

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Mock auth — leave all three blank.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM — optional. Leave blank to run the deterministic Data Science engine
# (profiling, quality, cleaning, EDA, ML) without AI narration; set a Gemini
# key to enable Ask InsightMind and the AI chat.
LLM_PROVIDER=gemini
LLM_CREDENTIAL_MODE=hybrid
GEMINI_API_KEY=
# gemini-flash-latest is an alias that tracks the current flash model. If you
# hit intermittent 503 "high demand" errors, switch to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-flash-latest
GEMINI_ALLOWED_MODELS=gemini-flash-latest,gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ALLOWED_MODELS=gpt-5-mini,gpt-4.1-mini

LEMON_SQUEEZY_WEBHOOK_SECRET=dev-only-not-used
