# InsightMind AI — DEV-ONLY frontend image.
# Bakes dev-mode VITE_* values so the SPA runs with mock auth and no Supabase.
# Used by docker-compose.dev.yml. The production image is ./Dockerfile.

FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Vite reads VITE_* from the environment at build time (env takes precedence
# over any .env file). These are dev defaults; override with build args.
ARG VITE_API_BASE_URL=http://localhost:8000/api
ARG VITE_DEV_MODE=true
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_DEV_MODE=$VITE_DEV_MODE \
    VITE_SUPABASE_URL= \
    VITE_SUPABASE_ANON_KEY=

COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
